{
  "TCP": {
    "443": {
      "HTTPS": true
    },
    "8443": {
      "HTTPS": true
    },
    "10000": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://web:3000"
        }
      }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": {
        "/": {
          "Proxy": "http://museum:8080"
        }
      }
    },
    "${TS_CERT_DOMAIN}:10000": {
      "Handlers": {
        "/": {
          "Proxy": "http://web:3003"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": false,
    "${TS_CERT_DOMAIN}:8443": false,
    "${TS_CERT_DOMAIN}:10000": false
  }
}
